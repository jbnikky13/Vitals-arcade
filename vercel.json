{
  "rewrites": [
    { "source": "/", "destination": "/miniapp.html" },
    { "source": "/pong", "destination": "/games/pong/index.html" },
    { "source": "/pong/", "destination": "/games/pong/index.html" }
  ],
  "headers": [
    {
      "source": "/.well-known/farcaster.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json" },
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    }
  ]
}
